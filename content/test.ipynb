   "source": [
    "import pyvista as pv\n",
    "pv.set_jupyter_backend(\"html\")\n",
    "pv.OFF_SCREEN = False\n",
    "cyl = pv.Cylinder()\n",
    "pl = pv.Plotter(shape=(3, 3))\n",
    "pl.subplot(0, 0)\n",
    "pl.add_mesh(cyl, color='lightblue', show_edges=True)\n",
    "pl.show()"
   ]
